#!/bin/bash
#PBS -l select=1:ncpus=4:mpiprocs=4
#PBS -q SMP
#PBS -N python
#PBS -o $PBS_O_WORKDIR/log.txt
#PBS -e $PBS_O_WORKDIR/error.txt
source ~/.bashrc
cd ${PBS_O_WORKDIR}

export MPLBACKEND=Agg

time python3 sd_output.py --input-dir .. --output tracking_trajectories.nc
time python3 traj_plot.py --input tracking_trajectories.nc --output-base particle_trajectories
